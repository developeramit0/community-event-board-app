datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  role         String              @default("USER")
  createdAt    DateTime            @default(now())
  favourites   FavouriteCategory[]
  reminders    Reminder[]
  cardDesigns  EventCardDesign[]
}

model Event {
  id           String            @id @default(cuid())
  title        String
  category     String
  city         String
  startsAt     DateTime
  priceInPaise Int
  description  String
  imageUrl     String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  reminders    Reminder[]
  cardDesigns  EventCardDesign[]

  @@index([isActive, startsAt])
  @@index([category, city, isActive, startsAt])
}

model FavouriteCategory {
  userId   String
  category String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

model Reminder {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model EventCardDesign {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  theme     String
  stickers  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}